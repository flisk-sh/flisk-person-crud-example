{
  "port": 3000,
  "dependsOn": [
    "person-api"
  ],
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "dev": {
    "command": "bun run dev",
    "watch": [
      "src/**/*",
      "public/**/*"
    ]
  },
  "$schema": "https://tdk-landscape.github.io/schema.service.json",
  "schemaVersion": 1,
  "appName": "person-app",
  "appType": "frontend",
  "featuresEnabled": [
    "api-client",
    "env-config",
    "api-index"
  ],
  "name": "person-app",
  "type": "frontend",
  "stack": "people",
  "framework": "react"
}
